# ------------------  INPUTS TO MAIN PROGRAM  -------------------
#
# Refined DogboneAnalytic matched to the ROMS nested dogbone case in ~/software/COAWST
# (ROMS/External/roms_dogbone_refined.in, Ngrids = 2, ratio 3).
#
# inputs_roms_baseline is the single-level control: identical except for the refinement
# block at the bottom of this file.
#
# Verified against dogbone_his_whole.nc: geometry, land mask (168 masked cells of 748),
# initial temperature (5 C for x < 1000, else 10 C), salinity (35 uniform) and the
# free-surface ramp all agree. REMORA's DogboneAnalytic defaults already reproduce the ROMS
# initial state exactly -- zeta = -0.00125*(x - 100) + 1.25 for x < 1100 gives 1.25, 1.00,
# 0.75, 0.50, 0.25, 0.00 at x = 100, 300, 500, 700, 900, 1100, which is what ROMS holds.
#
# The case is a dam break: a 1.25 m free-surface ramp against the western wall, released
# from rest. The front needs about 260 s to reach the fine box at x = 2600, so a run has to
# be several hundred steps long before the interface sees anything at all.
#
# Three settings differ from Exec/DogboneAnalytic/inputs_ml and are set here to ROMS values:
#   N = 10 vertical levels, not 16
#   Coriolis on, f = 1.458e-4 (inputs_ml turns it off)
#   dt = 2.0 with ndtfast = 20, matching roms_dogbone_refined.in rather than the DT = 6.0
#     in roms_dogbone_whole.in
#
# Remaining known differences, not expressible as inputs: ROMS builds this case with
# SPLINES_VDIFF and SPLINES_VVISC (spline vertical diffusion and viscosity) and DJ_GRADPS
# for the pressure gradient.
#
remora.prob_name = DogboneAnalytic

remora.max_step = 600

# PROBLEM SIZE & GEOMETRY
# ROMS Lm = 42, Mm = 15, N = 10 over 8400 x 750 x 10 m, so dx = 200, dy = 50, dz = 1.
remora.prob_lo     =   0.     0.   -10.
remora.prob_hi     =   8400.  750.   0.
remora.n_cell      =   42     15     10

# ROMS LBC is Clo (closed) on all four sides for every variable.
remora.is_periodic = 0 0 0
remora.bc.xlo.type = "slipwall"
remora.bc.xhi.type = "slipwall"
remora.bc.ylo.type = "slipwall"
remora.bc.yhi.type = "slipwall"

# TIME STEP CONTROL
remora.fixed_dt = 2.0
remora.ndtfast  = 20

# DIAGNOSTICS
remora.v             = 1
remora.sum_interval  = 10
remora.sum_precision = 12
remora.data_log      = roms_refined.log

# PLOTFILES
remora.plot_file     = plt_roms_ref/plt
remora.plot_int      = 1
remora.plot_vars_3d  = salt temp x_velocity y_velocity z_velocity
remora.plot_vars_2d  = zeta ubar vbar
remora.plotfile_type = netcdf

remora.check_file = chk
remora.check_int  = -1

# VERTICAL COORDINATE
# ROMS Vtransform 2, Vstretching 4, theta_s = theta_b = 0, Tcline = 1e16. With hc that large
# the transform reduces to z = zeta + (zeta + h) * s, so the levels are uniform and the
# quadratic Cs_r that Vstretching 4 reports never takes effect.
remora.theta_s = 0.0
remora.theta_b = 0.0
remora.tcline  = 1.0e16

# SOLVER CHOICE
remora.tracer_horizontal_advection_scheme = "upstream3"
remora.vertical_mixing_type = analytic
remora.Akt_bak = 1.0e-6
remora.Akv_bak = 1.0e-5

# ROMS UV_QDRAG with RDRG2 = 3.0e-3.
remora.bottom_stress_type = "quadratic"
remora.rdrag2 = 3.0e-3

# CORIOLIS
# ROMS f is uniform at 1.458e-4 across the grid, so beta_plane with beta = 0 is an f-plane.
remora.use_coriolis  = false
remora.coriolis_type = beta_plane
remora.coriolis_f0   = 1.458e-4
remora.coriolis_beta = 0.0

# ROMS uses g = 9.81 exactly (mod_scalars.F). REMORA's default is the physical 9.80665, which
# alone puts the two models 3.4e-4 apart in velocity -- enough to swamp any nesting difference.
# remora.g exists for exactly this: matching another model, not for production runs.
remora.g = 9.81

# EQUATION OF STATE
remora.R0    = 1027.0
remora.S0    = 35.0
remora.T0    = 10.0
remora.Tcoef = 1.7e-4
remora.Scoef = 7.6e-4
remora.rho0  = 1025.0

# INITIAL AND MASK SETUP
# Defaults reproduce ROMS: traditional gives the flat 10 m bottom and the 5 C western
# temperature patch; the analytic mask carves the dogbone waist, water only for
# 250 < y < 500 where 2800 < x < 5600.
remora.ic_type         = "analytic"
remora.mask_type       = "analytic"
remora.prob.traditional = 1

remora.init_l1ad_h = false
remora.init_l1ad_T = false
remora.init_l0int_h = true
remora.init_l0int_T = true
remora.init_ana_h = false
remora.init_ana_T = false

# REFINEMENT
# The fine box is taken from ROMS's child grid in dogbone_his_href3.nc, whose interior
# spans x = 2600..5800 and y = 250..500 at dx = 66.667, dy = 16.667 -- the parent spacing
# divided by 3. REMORA tags cells whose centres fall inside in_box_lo..in_box_hi, so
# 2601..5799 selects centres 2700..5700 and gives faces at 2600 and 5800; 255..505 selects
# centres 275..475 and gives faces at 250 and 500.
#
# That makes the x-normal interfaces one coarse cell wider on each side than
# inputs_ml_mid's 2800..5600 box. The y-normal edges coincide with the land mask, as they
# do in ROMS, so the x-normal pair is the only interface in open water.
remora.refinement_indicators = middle
remora.coupling_type = "TwoWay"
remora.middle.max_level  = 1
remora.middle.in_box_lo  = 2601 255 -10
remora.middle.in_box_hi  = 5799 505   0

amr.max_level      = 1
amr.ref_ratio_vect = 3 3 1

# ---------------------------------------------------------------------------------------
# Coarse-fine treatment matched to ROMS's nesting.F.
#
# These are all defaults now, listed here only because this is the deck the matching was
# measured on. Setting any of them to 0 restores the AMReX-native operator it replaced:
#
#   cf_avgdown_stencil  fine2coarse2d averages the donor over a (Rscale-1)/2 half-width
#                       stencil in BOTH directions, so at ratio 3 a coarse face is the mean
#                       of nine fine faces; average_down_faces takes only the three that
#                       tile the coarse face. The dominant term for matching ROMS: with
#                       cf_flux_pc it moves the refinement perturbation at the interface from
#                       1.29x ROMS's to 1.01x. The nine-point mean does not preserve transport
#                       across the interface, so it is not conservative in principle, but
#                       measured it costs only about 3e-10 of volume drift.
#   cf_flux_pc          get_persisted2d copies DU_avg2 at the donor face picked by integer
#                       division of the fine index, so every fine face under one parent face
#                       carries the same transport, scaled by edge length; AMReX's face
#                       interpolator gives it a linear variation instead. Both conserve the
#                       total. Removes the fine level's own excess divergence.
#   cf_fill_all_kcomp   put_refine2d writes zeta(:,:,1:3) and Zt_avg1; without this the
#                       records the solver reads in the ghost band go a parent step stale.
#   cf_time_interp_zeta put_refine2d interpolates the donor onto the child's own sub-time
#                       rather than freezing it at the end of the parent step.
#
# The last two are all but inert on THIS deck -- the fine zeta halo is barely read, so a 21x
# change in it moves the answer by 9e-17 -- but they are not free in general. They write the
# free surface in the ghost band, and volume is the integral of the free surface, so on the
# subcycled dogbone (Tests/CTestList.cmake, DogboneAnalytic_ML_conservation) they are what
# costs volume conservation: 2.9e-08 and 1.4e-08 of drift over 20 steps against 2.0e-09 with
# both off. ROMS makes the same trade.
#
# Left at their defaults because the defaults already match ROMS: cf_avgdown_perimeter = 1
# (ROMS has #undef REFINE_BOUNDARY, so it does not write the coarse perimeter either),
# cf_set_2d_bcs = 1 (u2dbc_im re-imposes every fast step, so 2 is NOT the ROMS schedule),
# time_interp_flux = 0 (ROMS has TIME_INTERP_FLUX undefined), cf_avgdown_bar = 1.
#
# Not on by default and not set here: cf_impose_flux writes the transport itself rather than
# a velocity the solver re-converts with its depth at another time index. ROMS gets that for
# free because u2dbc_im builds D from the same record it writes. It is what closes the last
# 1% of the interface perturbation -- 1.01x ROMS's with the defaults above, 1.0000x with this
# added -- and is worth 100x to 4000x while the flow is linear, but about 10-20% worse once it
# is not, so it stays a judgement call.
# remora.cf_impose_flux = 1
#
# The measurements used this deck with the h=50 bathymetry and matched time refinement:
#   remora.prob.depth=50.0 remora.prob_lo="0.0 0.0 -50.0"
#   remora.fixed_dt=3.0 remora.dt_ref_ratio=3
# against ROMS DT == 3.0 1.0 / NDTFAST == 20 20. As it stands this deck is the h=10, dt=2
# case, whose fine level takes dt/3 while roms_dogbone_refined.in steps both grids at 2.0.
# ---------------------------------------------------------------------------------------
