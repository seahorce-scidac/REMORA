# ------------------  INPUTS TO MAIN PROGRAM  -------------------
remora.prob_name = BioToy

remora.max_step = 10 #1600

# PROBLEM SIZE & GEOMETRY
remora.prob_lo     =      0.     0.    -210.585686295133
remora.prob_hi     =  100000. 5000.       0.

remora.n_cell           =  4     4      30

remora.is_periodic = 1 1 0

