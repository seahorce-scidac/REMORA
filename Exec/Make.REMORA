AMREX_HOME      ?= $(REMORA_HOME)/Submodules/AMReX

ifeq ($(USE_FUNWAVE_FORT), TRUE)
DEFINES += -DREMORA_USE_FUNWAVE_FORT
endif

# Fennel biology Fortran bridge (Path A validation oracle). Builds the
# tracked copy of the ROMS Fennel kernel alongside the native C++ port and
# selects between them at run time via remora.use_biology_cpp_answer, so
# comparing the two paths never requires a rebuild.
ifeq ($(USE_FENNEL_FORT), TRUE)
DEFINES += -DREMORA_USE_FENNEL_FORT
endif

# Fennel biology parity diagnostics (the Tier-1 tag emitters). Compiled out by
# default: the C++ emitters live inside the AMREX_GPU_DEVICE column lambda, so
# leaving them in costs device printf machinery and closure captures in every
# production build. Independent of USE_FENNEL_FORT on purpose -- the native
# kernel carries tag instrumentation whether or not the bridge is built.
# When enabled, remora.biology_debug still selects verbosity at run time.
ifeq ($(USE_BIOLOGY_DIAG), TRUE)
DEFINES += -DREMORA_USE_BIOLOGY_DIAG
endif

BL_NO_FORT = TRUE
ifeq ($(USE_FUNWAVE_FORT), TRUE)
BL_NO_FORT = FALSE
endif
ifeq ($(USE_FENNEL_FORT), TRUE)
BL_NO_FORT = FALSE
endif

include $(AMREX_HOME)/Tools/GNUMake/Make.defs

EBASE = REMORA
USE_RPATH = TRUE

REMORA_EXEC_DIR = $(REMORA_HOME)/Exec
include $(REMORA_EXEC_DIR)/Make.package

VPATH_LOCATIONS   += $(REMORA_EXEC_DIR)
INCLUDE_LOCATIONS += $(REMORA_EXEC_DIR)

REMORA_SOURCE_DIR = $(REMORA_HOME)/Source
include $(REMORA_SOURCE_DIR)/Make.package

VPATH_LOCATIONS   += $(REMORA_SOURCE_DIR)
INCLUDE_LOCATIONS += $(REMORA_SOURCE_DIR)

REMORA_BIOLOGY_DIR = $(REMORA_SOURCE_DIR)/Biology
include $(REMORA_BIOLOGY_DIR)/Make.package

VPATH_LOCATIONS   += $(REMORA_BIOLOGY_DIR)
INCLUDE_LOCATIONS += $(REMORA_BIOLOGY_DIR)

ifeq ($(USE_FENNEL_FORT), TRUE)
REMORA_FENNEL_FORT_DIR = $(REMORA_BIOLOGY_DIR)/Fortran
include $(REMORA_FENNEL_FORT_DIR)/Make.package
VPATH_LOCATIONS   += $(REMORA_FENNEL_FORT_DIR)
INCLUDE_LOCATIONS += $(REMORA_FENNEL_FORT_DIR)
endif

REMORA_TIMEINT_DIR = $(REMORA_SOURCE_DIR)/TimeIntegration
include $(REMORA_TIMEINT_DIR)/Make.package

VPATH_LOCATIONS   += $(REMORA_TIMEINT_DIR)
INCLUDE_LOCATIONS += $(REMORA_TIMEINT_DIR)

ifeq ($(USE_FUNWAVE_FORT), TRUE) 
REMORA_FUNWAVE_DIR = $(REMORA_SOURCE_DIR)/TimeIntegration/FUNWAVE
include $(REMORA_FUNWAVE_DIR)/Make.package
VPATH_LOCATIONS   += $(REMORA_FUNWAVE_DIR)
INCLUDE_LOCATIONS += $(REMORA_FUNWAVE_DIR)
endif

REMORA_BC_DIR = $(REMORA_SOURCE_DIR)/BoundaryConditions
include $(REMORA_BC_DIR)/Make.package

VPATH_LOCATIONS   += $(REMORA_BC_DIR)
INCLUDE_LOCATIONS += $(REMORA_BC_DIR)

REMORA_INIT_DIR = $(REMORA_SOURCE_DIR)/Initialization
include $(REMORA_INIT_DIR)/Make.package

VPATH_LOCATIONS   += $(REMORA_INIT_DIR)
INCLUDE_LOCATIONS += $(REMORA_INIT_DIR)

REMORA_UTIL_DIR = $(REMORA_SOURCE_DIR)/Utils
include $(REMORA_UTIL_DIR)/Make.package

VPATH_LOCATIONS   += $(REMORA_UTIL_DIR)
INCLUDE_LOCATIONS += $(REMORA_UTIL_DIR)

REMORA_PROB_DIR = $(REMORA_SOURCE_DIR)/Prob
include $(REMORA_PROB_DIR)/Make.package

VPATH_LOCATIONS   += $(REMORA_PROB_DIR)
INCLUDE_LOCATIONS += $(REMORA_PROB_DIR)

REMORA_IO_DIR = $(REMORA_SOURCE_DIR)/IO
include $(REMORA_IO_DIR)/Make.package

VPATH_LOCATIONS   += $(REMORA_IO_DIR)
INCLUDE_LOCATIONS += $(REMORA_IO_DIR)

include $(REMORA_PROBLEM_DIR)/Make.package

VPATH_LOCATIONS   += $(REMORA_PROBLEM_DIR)
INCLUDE_LOCATIONS += $(REMORA_PROBLEM_DIR)

include $(AMREX_HOME)/Src/Base/Make.package

AMReXdirs             := Base Boundary AmrCore

ifeq ($(USE_PARTICLES),TRUE)
AMReXdirs             += Particle
endif

AMReXpack             += $(foreach dir, $(AMReXdirs), $(AMREX_HOME)/Src/$(dir)/Make.package)

include $(AMReXpack)

ifeq ($(USE_PARTICLES),TRUE)
REMORA_PARTICLES_DIR = $(REMORA_SOURCE_DIR)/Particles
include $(REMORA_PARTICLES_DIR)/Make.package
VPATH_LOCATIONS   += $(REMORA_PARTICLES_DIR)
INCLUDE_LOCATIONS += $(REMORA_PARTICLES_DIR)
endif

#turn on PNetCDF macro define
ifeq ($(USE_PNETCDF), TRUE)
  USERSuffix = .PNC
  DEFINES += -DREMORA_USE_NETCDF
  includes += $(shell pkg-config --cflags pnetcdf)
  LIBRARIES += $(shell pkg-config --libs pnetcdf)
endif

#turn on MOAB macro define
ifeq ($(USE_MOAB), TRUE)
  ifeq ($(USE_NETCDF), TRUE)
    USERSuffix = .MB.NC
  else
    USERSuffix = .MB
  endif
  DEFINES += -DREMORA_USE_MOAB
  PKG_CONFIG_PATH  := $(PKG_CONFIG_PATH):$(MOAB_DIR)/lib/pkgconfig
  includes += $(shell pkg-config --cflags MOAB)
  LIBRARIES += $(shell pkg-config --libs MOAB)
endif

ifeq ($(USE_PARTICLES), TRUE)
  DEFINES += -DREMORA_USE_PARTICLES
endif

CEXE_sources += AMReX_buildInfo.cpp
CEXE_headers += $(AMREX_HOME)/Tools/C_scripts/AMReX_buildInfo.H
INCLUDE_LOCATIONS += $(AMREX_HOME)/Tools/C_scripts

include $(AMREX_HOME)/Tools/GNUMake/Make.rules

all: $(executable)
	(SILENT) $(RM) AMReX_buildInfo.cpp
	@echo SUCCESS

AMReX_buildInfo.cpp:
	$(AMREX_HOME)/Tools/C_scripts/makebuildinfo_C.py \
          --amrex_home "$(AMREX_HOME)" \
          --COMP "$(COMP)" --COMP_VERSION "$(COMP_VERSION)" \
          --CXX_comp_name "$(CXX)" \
          --CXX_flags "$(CXXFLAGS) $(CXXFLAGS) $(CPPFLAGS) $(includes)" \
          --link_flags "$(LINKFLAGS) $(CPPFLAGS) $(includes) $(LDFLAGS)" \
          --libraries "$(FINAL_LIBS)" \
          --MODULES "$(MNAMES)" \
          --GIT "$(REMORA_HOME) $(AMREX_HOME)"

clean::
	$(SILENT) $(RM) AMReX_buildInfo.cpp
