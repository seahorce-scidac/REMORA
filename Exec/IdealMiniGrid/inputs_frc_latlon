# ------------------  INPUTS TO MAIN PROGRAM  -------------------
#
# inputs_frc with Uwind, Vwind and Tair on a coarse lat-lon grid and a rotated copy of the
# grid, to exercise the forcing regrid and the rotation of winds onto the grid axes. Make the
# two files in the remora-data IdealMiniGrid directory, run there, then check the history file:
#
#   python3 Tests/tools/make_latlon_forcing_test_data.py make --grid idmini_grd_v1_classic64.nc \
#           --out idmini_frc_latlon.nc --rotated-grid idmini_grd_rotated.nc
#   python3 Tests/tools/make_latlon_forcing_test_data.py check plt_latlon_his_d01.nc
#
# With remora.bulk_fluxes = false and remora.smflux_type = "netcdf" in place of wind_type and
# tair_type, sustr and svstr are read from the same file instead; check them with --stress
# (the history file then has no winds or Tair to check, which --stress allows).
remora.prob_name = IdealMiniGrid

remora.max_step = 10

# PROBLEM SIZE & GEOMETRY
# dims come from ROMS ana_grid, and must match vals in prob.cpp right now
remora.prob_lo     =   0.       0.  -5000.
remora.prob_hi     =   320000.  320000.       0.

remora.n_cell           =  10 16 20

remora.is_periodic = 0 0 0

remora.bc.xlo.type = "clamped"
remora.bc.xhi.type = "clamped"
remora.bc.ylo.type = "clamped"
remora.bc.yhi.type = "clamped"

# TIME STEP CONTROL
remora.fixed_dt            = 200.0 # Timestep size (seconds)
remora.ndtfast = 1

# DIAGNOSTICS & VERBOSITY
remora.sum_interval  = 1       # timesteps between integrated/max quantities, if remora.v > 0
remora.v             = 0       # verbosity in REMORA.cpp (0: none, 1: integrated quantities, etc, 2: print boxes)

# CHECKPOINT FILES
remora.check_file      = chk        # root name of checkpoint file
remora.check_int       = -57600      # number of timesteps between checkpoints

# PLOTFILES
remora.plot_file     = plt_latlon # prefix of plotfile name
remora.plot_int      = 10           # number of timesteps between plotfiles
remora.plot_vars_3d  = salt temp x_velocity y_velocity z_velocity
remora.plotfile_type = netcdf
remora.output_forcing = true        # writes Tair, Uwind and Vwind to the history file

# SOLVER CHOICE
remora.tracer_horizontal_advection_scheme = "upstream3" # upstream3 or centered4

remora.use_coriolis  = true
remora.coriolis_type = netcdf
remora.coriolis_f0   = 1.0e-4 #-8.26e-5

remora.theta_s = 5.0
remora.theta_b = 0.5
remora.tcline = 100.

# PROBLEM PARAMETERS (optional)
remora.R0    = 1027.0  # background density value (Kg/m3) used in Linear Equation of State
remora.S0    = 32.0    # background salinity (nondimensional) constant
remora.T0    = 10.0    # background potential temperature (Celsius) constant
remora.Tcoef = 0.0  # linear equation of state parameter (1/Celsius)
remora.Scoef = 0.0     # linear equation of state parameter (nondimensional)
remora.rho0  = 1025.0  # Mean density (Kg/m3) used when Boussinesq approx is inferred

remora.bulk_fluxes = true
remora.wind_type = "netcdf"
remora.tair_type = "netcdf"

# The init and boundary files are at https://github.com/seahorce-scidac/REMORA-data; the grid
# and forcing files are made from them as described at the top
remora.ic_bc_type       = "netcdf"
remora.nc_init_file_0   = "idmini_ini_v1_classic64.nc"
remora.nc_grid_file_0   = "idmini_grd_rotated.nc"
remora.nc_bdry_file     = "idmini_bry_Salt_classic64.nc"
remora.nc_frc_file      = "idmini_frc_latlon.nc"
remora.frc_time_varname = "wind_time"
# The boundary and forcing files count days since 2020-01-01; put the model clock there
remora.time_ref         = 20200101
