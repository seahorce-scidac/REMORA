# Land-layout timing: the staircase-coastline grid of Tests/perf/make_masked_grid.py at
# factor 16 (160 x 256 x 20 cells, 36 % land) in 16 x 16 boxes. Compare remora.drop_dry_boxes =
# false/true and remora.load_balance_land_weight = 1/0; check with remora_subset_compare.
# Set amr.max_grid_size_x/y to change the box size; remora.n_cell = 10*f 16*f 20 for factor f.
remora.prob_name = IdealMiniGrid
remora.max_step = 20
remora.prob_lo     =   0.       0.  -5000.
remora.prob_hi     =   320000.  320000.       0.
remora.n_cell = 160 256 20
remora.is_periodic = 0 0 0
remora.bc.xlo.type = "slipwall"
remora.bc.xhi.type = "slipwall"
remora.bc.ylo.type = "slipwall"
remora.bc.yhi.type = "slipwall"
remora.fixed_dt = 30.0
remora.ndtfast = 20
remora.v             = 0
remora.check_file      = chk
remora.check_int = -1
remora.plot_file     = plt
remora.plot_int = -1
remora.plot_vars_3d  = salt temp x_velocity y_velocity z_velocity
remora.plotfile_type = amrex
remora.tracer_horizontal_advection_scheme = "upstream3"
remora.use_coriolis  = true
remora.coriolis_type = netcdf
remora.theta_s = 5.0
remora.theta_b = 0.5
remora.tcline = 100.
remora.R0    = 1027.0
remora.S0    = 32.0
remora.T0    = 10.0
remora.Tcoef = 1.7e-4
remora.Scoef = 0.0
remora.rho0  = 1025.0
remora.ic_type       = "netcdf"
remora.mask_type     = "netcdf"
remora.nc_init_file_0   = "ini.nc"
remora.nc_grid_file_0   = "grid.nc"
remora.time_ref         = 20200101
remora.horizontal_mixing_type = constant
remora.visc2 = 100.0
remora.tnu2_temp = 50.0
remora.tnu2_salt = 50.0
amr.max_grid_size_x = 16
amr.max_grid_size_y = 16
amr.blocking_factor_x = 16
amr.blocking_factor_y = 16
