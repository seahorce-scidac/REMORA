# NetCDF read timing: the grid, initial and wind-forcing files of
# Tests/perf/make_read_scaling_data.py, read from the run directory, on walls so no boundary
# file is needed. remora.max_step = 0 reads everything and stops, which isolates the cost of
# reading; build with REMORA_ENABLE_TINY_PROFILE for the per-reader times, and set remora.v = 1
# for the read-region ratio. n_cell must match the generator's --n-cell and prob_hi its
# --n-cell times --dx (1000 m); for NetCDF-4 files written with --suffix _nc4z, add the suffix
# to the three file names on the command line.
remora.prob_name = IdealMiniGrid
remora.max_step = 0
remora.prob_lo     =   0.         0.  -5000.
remora.prob_hi     =   1536000.   1536000.     0.
remora.n_cell      =   1536 1536 32
remora.is_periodic = 0 0 0
remora.bc.xlo.type = "slipwall"
remora.bc.xhi.type = "slipwall"
remora.bc.ylo.type = "slipwall"
remora.bc.yhi.type = "slipwall"
# The barotropic step, fixed_dt / ndtfast = 2 s, has to stay below about
# dx / sqrt(9.8 * depth) = 4.5 s, or a run with steps blows up without stopping.
remora.fixed_dt = 60.0
remora.ndtfast  = 30
remora.v        = 0
remora.check_int = -1
remora.plot_file = plt
remora.plot_int  = -1
remora.plot_vars_3d  = salt temp x_velocity y_velocity z_velocity
remora.plotfile_type = amrex
remora.tracer_horizontal_advection_scheme = "upstream3"
remora.use_coriolis  = true
remora.coriolis_type = netcdf
remora.theta_s = 5.0
remora.theta_b = 0.5
remora.tcline = 100.
remora.R0    = 1027.0
remora.S0    = 32.0
remora.T0    = 10.0
remora.Tcoef = 0.0
remora.Scoef = 0.0
remora.rho0  = 1025.0
remora.bulk_fluxes = true
remora.wind_type = "netcdf"
remora.ic_bc_type     = "netcdf"
remora.nc_init_file_0 = "scaling_ini.nc"
remora.nc_grid_file_0 = "scaling_grd.nc"
remora.nc_frc_file    = "scaling_frc.nc"
remora.time_ref       = 20200101
amr.max_grid_size = 64
